+# ==================== AGENT PLATFORM WEBHOOKS ====================
+
+WEBHOOK_SECRET = os.environ.get('AGENT_WEBHOOK_SECRET', 'dev-secret-change-in-production')
+
+
+def verify_webhook_signature(request):
+    """Verify HMAC signature from agent platform"""
+    signature = request.headers.get('X-Webhook-Signature', '')
+    if not signature:
+        return False
+    payload = request.get_data()
+    expected = f"sha256={hmac.new(WEBHOOK_SECRET.encode(), payload, hashlib.sha256).hexdigest()}"
+    return hmac.compare_digest(signature, expected)
+
+
+@app.route('/webhooks/agent-results', methods=['POST'])
+def receive_agent_results():
+    """Receive screening results from Agent Platform"""
+    if os.environ.get('FLASK_ENV') == 'production':
+        if not verify_webhook_signature(request):
+            return jsonify({"error": "Invalid signature"}), 401
+
+    data = request.get_json()
+    if not data:
+        return jsonify({"error": "No data provided"}), 400
+
+    event = data.get('event')
+    application_id = data.get('application_id')
+    results = data.get('results', {})
+
+    if event == 'screening_complete' and application_id:
+        application = Application.query.get(application_id)
+        if not application:
+            return jsonify({"error": f"Application {application_id} not found"}), 404
+
+        application.technical_score = results.get('technical_score')
+        application.research_score = results.get('research_score')
+        application.culture_fit_score = results.get('culture_fit_score')
+        application.overall_score = results.get('overall_score')
+
+        recommendation = results.get('recommendation', 'review')
+        if recommendation == 'advance_to_human_review':
+            application.status = 'reviewing'
+            application.stage = 'pending_human_review'
+        elif recommendation == 'pass':
+            application.status = 'rejected'
+            application.stage = 'agent_rejected'
+        else:
+            application.status = 'screening'
+            application.stage = 'agent_reviewed'
+
+        reasoning = results.get('reasoning', '')
+        audit_id = results.get('audit_id', '')
+        application.notes = f"[Agent Analysis - {audit_id}]\n{reasoning}\n\nRecommendation: {recommendation}"
+
+        audit_log = AgentAuditLog(
+            application_id=application_id,
+            agent_name='ScreenerAgent',
+            action='screening_complete',
+            output_data=str(results),
+            reasoning=reasoning,
+            bias_check_passed=results.get('bias_check', {}).get('passed', True)
+        )
+        db.session.add(audit_log)
+        db.session.commit()
+
+        return jsonify({"received": True, "application_id": application_id, "status_updated": application.status})
+
+    return jsonify({"received": True, "event": event})
+
+
+@app.route('/webhooks/bias-alert', methods=['POST'])
+def receive_bias_alert():
+    """Receive bias threshold alerts from Agent Platform"""
+    if os.environ.get('FLASK_ENV') == 'production':
+        if not verify_webhook_signature(request):
+            return jsonify({"error": "Invalid signature"}), 401
+
+    data = request.get_json()
+    if not data:
+        return jsonify({"error": "No data provided"}), 400
+
+    alert = BiasAlert(
+        job_id=data.get('job_id'),
+        metric=data.get('metric', 'unknown'),
+        value=data.get('value'),
+        threshold=data.get('threshold', 0.80),
+        affected_group=data.get('affected_group'),
+        recommended_action=data.get('recommended_action')
+    )
+    db.session.add(alert)
+
+    if data.get('recommended_action') == 'pause_automated_screening':
+        job_id = data.get('job_id')
+        if job_id:
+            job = Job.query.get(job_id)
+            if job:
+                job.requirements = (job.requirements or '') + '\n\n[ALERT] Automated screening paused due to bias threshold warning.'
+
+    db.session.commit()
+    return jsonify({"received": True, "alert_id": alert.id})
+
+
+@app.route('/api/bias-alerts', methods=['GET'])
+def get_bias_alerts():
+    """Get all bias alerts"""
+    job_id = request.args.get('job_id', type=int)
+    query = BiasAlert.query
+    if job_id:
+        query = query.filter_by(job_id=job_id)
+    alerts = query.order_by(BiasAlert.created_at.desc()).all()
+    return jsonify({"alerts": [a.to_dict() for a in alerts], "total": len(alerts)})
+
+
+@app.route('/api/bias-alerts/<int:alert_id>/resolve', methods=['POST'])
+def resolve_bias_alert(alert_id):
+    """Mark a bias alert as resolved"""
+    alert = BiasAlert.query.get_or_404(alert_id)
+    data = request.get_json() or {}
+    alert.resolved = True
+    alert.resolved_at = datetime.utcnow()
+    alert.resolution_notes = data.get('notes', 'Resolved by user')
+    db.session.commit()
+    return jsonify(alert.to_dict())
+
+
+@app.route('/api/audit-log', methods=['GET'])
+def get_audit_log():
+    """Get agent audit trail for compliance"""
+    application_id = request.args.get('application_id', type=int)
+    query = AgentAuditLog.query
+    if application_id:
+        query = query.filter_by(application_id=application_id)
+    logs = query.order_by(AgentAuditLog.created_at.desc()).limit(100).all()
+    return jsonify({"audit_logs": [log.to_dict() for log in logs], "total": len(logs)})
+
+
